# CDC ClickHouse POC - example environment configuration
#
# Copy this file to `.env` on each machine and fill in the local values.
# Never commit `.env` or real credentials.

# -----------------------------------------------------------------------------
# FastAPI application
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Oracle source system
# -----------------------------------------------------------------------------
CDC_APP_USER=CDC_APP
CDC_APP_PASSWORD=
CDC_APP_DSN=localhost:1521/FREEPDB1

# Optional Debezium LogMiner user values if local tooling needs them.
# Keep real credentials only in `.env`, never here.
DBZ_ORACLE_USER=
DBZ_ORACLE_PASSWORD=

# -----------------------------------------------------------------------------
# ClickHouse analytics
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Debezium / Kafka Connect
# -----------------------------------------------------------------------------
DEBEZIUM_URL=http://localhost:8083
DEBEZIUM_RAW_CONNECTOR=oracle-cdc
DEBEZIUM_FLAT_CONNECTOR=oracle-cdc-flat

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
# Use localhost:9092 when the FastAPI process runs directly on the RHEL host.
# Containers on the Docker network use kafka:19092 instead.
KAFKA_BOOTSTRAP=localhost:9092

KAFKA_PAYMENT_TOPIC=oracleflat.CDC_APP.PAYMENT
KAFKA_TAXPAYER_TOPIC=oracleflat.CDC_APP.TAXPAYER
KAFKA_STATION_TOPIC=oracleflat.CDC_APP.STATION

KAFKA_PAYMENT_GROUP=clickhouse-oracle-payment-poc-v1
KAFKA_TAXPAYER_GROUP=clickhouse-oracle-taxpayer-poc-v1
KAFKA_STATION_GROUP=clickhouse-oracle-station-poc-v1

# -----------------------------------------------------------------------------
# Simulator defaults
# -----------------------------------------------------------------------------
SIMULATOR_TRANSACTIONS_PER_MINUTE=10
SIMULATOR_PAYMENT_PERCENT=80
SIMULATOR_STATUS_UPDATE_PERCENT=15
SIMULATOR_TAXPAYER_MOVE_PERCENT=5

# Browser-controlled EFRIS simulator runtime. These are non-secret settings.
SIMULATOR_RUNTIME_DIR=runtime/simulator
SIMULATOR_STALE_SECONDS=10

# -----------------------------------------------------------------------------
# Optional UI / reporting configuration
# -----------------------------------------------------------------------------
# Leave blank until a stable Power BI report URL is available.
POWER_BI_REPORT_URL=
